+function vbMissedRecoverySettings(value = {}, fallback = {}) {
+  const source = value && typeof value === "object" ? value : {};
+  const prior = fallback && typeof fallback === "object" ? fallback : {};
+  const mode = ["webex-default","auto-after-60"].includes(String(source.mode || ""))
+    ? String(source.mode)
+    : ["webex-default","auto-after-60"].includes(String(prior.mode || ""))
+      ? String(prior.mode)
+      : "auto-after-60";
+  const secondsRaw = Number(source.seconds ?? prior.seconds ?? 60);
+  const seconds = Number.isSafeInteger(secondsRaw) && secondsRaw >= 15 && secondsRaw <= 600 ? secondsRaw : 60;
+  const allowAgentOverride = typeof source.allowAgentOverride === "boolean"
+    ? source.allowAgentOverride
+    : typeof prior.allowAgentOverride === "boolean"
+      ? prior.allowAgentOverride
+      : true;
+  return { mode, seconds, allowAgentOverride };
+}
