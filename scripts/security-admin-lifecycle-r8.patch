 const MFA_SETUP_PREFIX = "security-mfa-setup:";
 const MFA_PENDING_PREFIX = "pending:";
 const MFA_SETUP_TTL_SECONDS = 10 * 60;
+
+const SECURITY_CONFIG_AUDIT_PREFIX = "security-config-audit:";
+const SECURITY_SESSION_INDEX_PREFIX = "security-session-index:";
+const SECURITY_HISTORY_LIMIT = 100;
+
+async function securitySessionFingerprint(sessionId) {
+  return (await portalSha256Hex(String(sessionId || ""))).slice(0, 24);
+}
+
+async function ensureSecuritySessionIndex(env, session) {
+  if (!session?.id || !env?.SESSIONS?.put) return;
+  const fingerprint = await securitySessionFingerprint(session.id);
+  const value = {
+    sessionId: session.id,
+    fingerprint,
+    username: normalizeUsername(session.username),
+    role: String(session.role || "view").toLowerCase(),
+    created: Number(session.created) || Date.now(),
+    expires: Number(session.expires) || 0,
+    ip: String(session.ip || "unknown").slice(0, 64),
+    browser: String(session.browser || "Unknown").slice(0, 120)
+  };
+  const ttl = Math.max(60, Math.ceil((value.expires - Date.now()) / 1000));
+  await env.SESSIONS.put(SECURITY_SESSION_INDEX_PREFIX + fingerprint, JSON.stringify(value), { expirationTtl: ttl });
+}
+
+async function removeSecuritySessionIndex(env, sessionId) {
+  if (!sessionId) return;
+  const fingerprint = await securitySessionFingerprint(sessionId);
+  if (env?.SESSIONS?.delete) await env.SESSIONS.delete(SECURITY_SESSION_INDEX_PREFIX + fingerprint);
+}
+
+async function revokeIndexedSessionsForUser(env, username) {
+  if (!env?.SESSIONS?.list) return 0;
+  const target = normalizeUsername(username);
+  let cursor;
+  let revoked = 0;
+  let pages = 0;
+  do {
+    const page = await env.SESSIONS.list({ prefix: SECURITY_SESSION_INDEX_PREFIX, limit: 500, ...(cursor ? { cursor } : {}) });
+    for (const key of page.keys || []) {
+      const raw = await env.SESSIONS.get(key.name);
+      let item = null;
+      try { item = raw ? JSON.parse(raw) : null; } catch {}
+      if (item && normalizeUsername(item.username) === target) {
+        if (item.sessionId) await env.SESSIONS.delete(item.sessionId);
+        await env.SESSIONS.delete(key.name);
+        revoked++;
+      }
+    }
+    cursor = page.list_complete === false ? page.cursor : undefined;
+    pages++;
+  } while (cursor && pages < 10);
+  return revoked;
+}
+
+async function writeSecurityConfigAudit(env, request, action, target, changes = [], details = {}) {
+  if (!env?.LOGS?.put) return;
+  const actor = getActorContext(request);
+  const session = await getVisionBankSessionFromRequest(request, env);
+  const at = new Date().toISOString();
+  const reverse = String(9999999999999 - Date.now()).padStart(13, "0");
+  const record = {
+    id: crypto.randomUUID(),
+    at,
+    action: String(action || "SECURITY_CHANGE").slice(0, 80),
+    target: String(target || "Security").slice(0, 160),
+    changes: Array.isArray(changes) ? changes.map(x => String(x).slice(0, 120)).slice(0, 20) : [],
+    actor: {
+      username: session?.username || "unknown",
+      role: session?.role || "unknown",
+      ip: String(actor.ip || "unknown").slice(0, 64)
+    },
+    details: details && typeof details === "object" ? details : {}
+  };
+  await env.LOGS.put(SECURITY_CONFIG_AUDIT_PREFIX + reverse + ":" + record.id, JSON.stringify(record));
+}
+
+async function handleSecurityConfigHistory(env, cors) {
+  if (!env?.LOGS?.list) return json({ events: [] }, cors);
+  const page = await env.LOGS.list({ prefix: SECURITY_CONFIG_AUDIT_PREFIX, limit: SECURITY_HISTORY_LIMIT });
+  const events = [];
+  for (const key of page.keys || []) {
+    const raw = await env.LOGS.get(key.name);
+    let item = null;
+    try { item = raw ? JSON.parse(raw) : null; } catch {}
+    if (!item) continue;
+    events.push({
+      id: item.id || "",
+      at: item.at || "",
+      action: item.action || "",
+      target: item.target || "",
+      changes: Array.isArray(item.changes) ? item.changes : [],
+      actor: {
+        username: item.actor?.username || "unknown",
+        role: item.actor?.role || "unknown",
+        ip: item.actor?.ip || "unknown"
+      },
+      details: item.details && typeof item.details === "object" ? item.details : {}
+    });
+  }
+  return json({ events }, cors);
+}
 
+async function handleSecuritySessionList(request, env, cors) {
+  const current = await getVisionBankSessionFromRequest(request, env);
+  if (!current) return json({ error: "session-required" }, cors, 401);
+  await ensureSecuritySessionIndex(env, current);
+  const currentFingerprint = await securitySessionFingerprint(current.id);
+  const sessions = [];
+  let cursor;
+  let pages = 0;
+  do {
+    const page = await env.SESSIONS.list({ prefix: SECURITY_SESSION_INDEX_PREFIX, limit: 500, ...(cursor ? { cursor } : {}) });
+    for (const key of page.keys || []) {
+      const rawIndex = await env.SESSIONS.get(key.name);
+      let index = null;
+      try { index = rawIndex ? JSON.parse(rawIndex) : null; } catch {}
+      if (!index?.sessionId) continue;
+      const rawSession = await env.SESSIONS.get(index.sessionId);
+      let stored = null;
+      try { stored = rawSession ? JSON.parse(rawSession) : null; } catch {}
+      const user = stored?.username ? await getUser(env, normalizeUsername(stored.username)) : null;
+      if (!stored || !stored.expires || Number(stored.expires) <= Date.now() || !user || user.enabled === false) {
+        if (index.sessionId) await env.SESSIONS.delete(index.sessionId);
+        await env.SESSIONS.delete(key.name);
+        continue;
+      }
+      const fingerprint = index.fingerprint || await securitySessionFingerprint(index.sessionId);
+      sessions.push({
+        fingerprint,
+        username: normalizeUsername(stored.username),
+        role: String(user.role || stored.role || "view").toLowerCase(),
+        createdAt: new Date(Number(stored.created || index.created || Date.now())).toISOString(),
+        expiresAt: new Date(Number(stored.expires)).toISOString(),
+        ip: String(stored.ip || index.ip || "unknown").slice(0, 64),
+        browser: String(stored.browser || index.browser || "Unknown").slice(0, 120),
+        current: fingerprint === currentFingerprint
+      });
+    }
+    cursor = page.list_complete === false ? page.cursor : undefined;
+    pages++;
+  } while (cursor && pages < 10);
+  sessions.sort((a, b) => String(b.createdAt).localeCompare(String(a.createdAt)));
+  return json({ sessions }, cors);
+}
+
+async function handleSecuritySessionRevoke(request, env, cors) {
+  const current = await getVisionBankSessionFromRequest(request, env);
+  if (!current) return json({ error: "session-required" }, cors, 401);
+  const body = await request.json();
+  const fingerprint = String(body.fingerprint || "").trim().toLowerCase();
+  if (!/^[0-9a-f]{24}$/.test(fingerprint)) return json({ error: "invalid-session-reference" }, cors, 400);
+  const currentFingerprint = await securitySessionFingerprint(current.id);
+  if (fingerprint === currentFingerprint) return json({ error: "cannot-revoke-current-session" }, cors, 409);
+  const key = SECURITY_SESSION_INDEX_PREFIX + fingerprint;
+  const raw = await env.SESSIONS.get(key);
+  let index = null;
+  try { index = raw ? JSON.parse(raw) : null; } catch {}
+  if (!index?.sessionId) return json({ error: "session-not-found" }, cors, 404);
+  await env.SESSIONS.delete(index.sessionId);
+  await env.SESSIONS.delete(key);
+  await writeSecurityConfigAudit(env, request, "SESSION_REVOKED", index.username || "unknown", ["Active session revoked"], { fingerprint });
+  return json({ success: true }, cors);
+}
+
+async function updateUserLoginFailure(env, username) {
+  const current = await getUser(env, normalizeUsername(username));
+  if (!current) return;
+  await saveUser(env, {
+    ...current,
+    lastFailedLoginAt: new Date().toISOString(),
+    failedLoginCount: Number(current.failedLoginCount || 0) + 1
+  });
+}
+
+async function updateUserLoginSuccess(env, username) {
+  const current = await getUser(env, normalizeUsername(username));
+  if (!current) return current;
+  const next = {
+    ...current,
+    enabled: current.enabled !== false,
+    lastSuccessfulLoginAt: new Date().toISOString(),
+    failedLoginCount: 0
+  };
+  await saveUser(env, next);
+  return next;
+}
+
+async function handleUserStatus(request, env, cors) {
+  const actorSession = await getVisionBankSessionFromRequest(request, env);
+  if (!actorSession) return json({ error: "session-required" }, cors, 401);
+  const body = await request.json();
+  const username = normalizeUsername(body.username);
+  const enabled = body.enabled === true;
+  if (!username || typeof body.enabled !== "boolean") return json({ error: "username-and-enabled-required" }, cors, 400);
+  if (username === actorSession.username && !enabled) return json({ error: "cannot-disable-current-account" }, cors, 409);
+  const user = await getUser(env, username);
+  if (!user) return json({ error: "User not found" }, cors, 404);
+  if ((user.enabled !== false) === enabled) return json({ success: true, user: safeUserForClient(user) }, cors);
+
+  if (!enabled && String(user.role || "").toLowerCase() === "superadmin") {
+    const users = await loadAllUsers(env);
+    const remaining = users.filter(u =>
+      normalizeUsername(u.username) !== username &&
+      String(u.role || "").toLowerCase() === "superadmin" &&
+      u.enabled !== false
+    );
+    if (!remaining.length) return json({ error: "at-least-one-enabled-superadmin-required" }, cors, 409);
+  }
+
+  const now = new Date().toISOString();
+  const next = {
+    ...user,
+    enabled,
+    updatedAt: now,
+    ...(enabled
+      ? { enabledAt: now, enabledBy: actorSession.username }
+      : { disabledAt: now, disabledBy: actorSession.username, sessionInvalidBefore: Date.now() })
+  };
+  await saveUser(env, next);
+  let revoked = 0;
+  if (!enabled) revoked = await revokeIndexedSessionsForUser(env, username);
+  await writeSecurityConfigAudit(env, request, enabled ? "USER_ENABLED" : "USER_DISABLED", username, [enabled ? "Account enabled" : "Account disabled"], { revokedSessions: revoked });
+  await queueSuperadminEvent(env, { action: enabled ? "USER_ENABLED" : "USER_DISABLED", severity: "HIGH", target: username, actor: getActorContext(request) });
+  return json({ success: true, user: safeUserForClient(next), revokedSessions: revoked }, cors);
+}
